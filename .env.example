# JotHost Panel — development environment template.
# Copy to .env and adjust. NEVER commit a real .env (ARCHITECTURE.md section 11).

# ----- Environment -----
JOTHOST_ENV=development
LOG_LEVEL=debug

# ----- Host ports -----
PANEL_PORT=8081
API_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# ----- PostgreSQL -----
POSTGRES_USER=jothost
POSTGRES_PASSWORD=jothost_dev_password
POSTGRES_DB=jothost

# ----- API -----
API_HTTP_ADDR=:8080
API_SHUTDOWN_TIMEOUT=15s
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=60s

# ----- Host Agent -----
# The Agent listens only on this Unix socket; it never opens a TCP port.
AGENT_SOCKET=/run/jothost/agent.sock
AGENT_TIMEOUT=30s
AGENT_OPERATION_TIMEOUT=30s
AGENT_SHUTDOWN_TIMEOUT=15s
AGENT_MAX_CONCURRENT=16

# ----- Secrets (Phase 1+) -----
# Generate with: openssl rand -hex 32
# JWT_SECRET=
# ENCRYPTION_KEY=
