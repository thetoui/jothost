# JotHost Panel — development environment template.
# Copy to .env and adjust. NEVER commit a real .env (ARCHITECTURE.md section 11).

# ----- Environment -----
JOTHOST_ENV=development
LOG_LEVEL=debug

# ----- Host ports -----
PANEL_PORT=8081
API_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# ----- PostgreSQL -----
POSTGRES_USER=jothost
POSTGRES_PASSWORD=jothost_dev_password
POSTGRES_DB=jothost

# ----- API -----
API_HTTP_ADDR=:8080
API_SHUTDOWN_TIMEOUT=15s
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=60s

# ----- Host Agent -----
# The Agent listens only on this Unix socket; it never opens a TCP port.
AGENT_SOCKET=/run/jothost/agent.sock
AGENT_TIMEOUT=30s
AGENT_OPERATION_TIMEOUT=30s
AGENT_SHUTDOWN_TIMEOUT=15s
AGENT_MAX_CONCURRENT=16

# Shared secret authenticating the API to the Agent. The API and the Agent must
# agree on it. REQUIRED in production; generate with: openssl rand -hex 32
# The value below is a DEVELOPMENT DEFAULT — replace it.
AGENT_TOKEN=dev-agent-token-0123456789abcdef0123456789abcdef

# UIDs permitted to call the Agent, checked against kernel-supplied peer
# credentials. 10001 is the API container's jothost user. Root is always
# allowed so the Agent's own health check works.
AGENT_ALLOWED_UIDS=10001

# The Agent's own append-only audit trail. It is kept separately from the
# database so the Agent stays accountable when Postgres is unreachable.
AGENT_AUDIT_LOG=/var/log/jothost/agent-audit.log

# Where the Agent reads host metrics. In production it runs on the host, so
# the defaults are correct; in a container these see the container's own view.
AGENT_PROC_ROOT=/proc
AGENT_SYS_ROOT=/sys

# Absolute path to systemctl. Configuration rather than a PATH lookup, so a
# hostile PATH cannot substitute a program.
AGENT_SYSTEMCTL_PATH=/usr/bin/systemctl

# Asynchronous job execution bounds.
AGENT_MAX_JOBS=256
AGENT_MAX_CONCURRENT_JOBS=4
AGENT_JOB_TIMEOUT=30m
AGENT_JOB_RETENTION=15m

# ----- Authentication (Phase 1) -----
# ENCRYPTION_KEY protects 2FA secrets at rest (AES-256-GCM).
# REQUIRED. Generate with: openssl rand -hex 32
# Losing or changing it makes every stored 2FA secret undecryptable.
# The value below is a DEVELOPMENT DEFAULT — replace it in production.
ENCRYPTION_KEY=0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0

# Token lifetimes. REFRESH_TOKEN_TTL must exceed ACCESS_TOKEN_TTL.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MFA_CHALLENGE_TTL=5m
TOTP_ISSUER=JotHost Panel

# Login throttling. The per-account limit is tighter than the per-IP limit so
# a shared NAT does not lock out an entire office.
LOGIN_RATE_LIMIT=5
LOGIN_IP_RATE_LIMIT=20
LOGIN_RATE_WINDOW=15m

# ----- Database migrations -----
MIGRATIONS_DIR=/app/migrations
# Applies pending migrations at startup. Set false to manage them manually
# with: jothost-api migrate up
AUTO_MIGRATE=true

# ----- First administrator -----
# Read by `jothost-api create-admin`, never by the running server.
# Set them for a single run; do not leave them in a committed file.
# JOTHOST_ADMIN_USERNAME=admin
# JOTHOST_ADMIN_PASSWORD=
# JOTHOST_ADMIN_EMAIL=
